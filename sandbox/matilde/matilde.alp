					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792676452605</Id>
					<Name><![CDATA[spread]]></Name>
					<X>170</X><Y>180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return bestAsk() - bestBid();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1792676473189</Id>
					<Name><![CDATA[collarHit]]></Name>
					<X>170</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!main.collarsActive) return false;
boolean dyn = Math.abs(p / lastPrice - 1) > main.dynamicThreshold;
boolean stat = Math.abs(p / refPrice - 1) > main.staticThreshold;
if (!dyn && !stat) return false;
int dir = p > lastPrice ? 1 : -1;
if (stat && dir == lastStaticDir) statechart.receiveMessage("STATIC_REPEAT");
else if (stat) { lastStaticDir = dir; statechart.receiveMessage("STATIC"); }
else statechart.receiveMessage("DYNAMIC");
return true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792677806700</Id>
					<Name><![CDATA[execute]]></Name>
					<X>170</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[Order]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Order]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[q]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[lastPrice = p;
volume += q;
b.qty -= q;
a.qty -= q;
main.onFill(b.trader, 1, q, p);
main.onFill(a.trader, -1, q, p);
if (b.qty == 0) bids.poll();
if (a.qty == 0) asks.poll();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792677861594</Id>
					<Name><![CDATA[match]]></Name>
					<X>170</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[while (!halted && !bids.isEmpty() && !asks.isEmpty()) {
    Order b = bids.peek();
    Order a = asks.peek();
    if (b.price < a.price) break;
    double p = (a.id < b.id) ? a.price : b.price;
    if (collarHit(p)) return;
    execute(b, a, p, Math.min(a.qty, b.qty));
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792677878251</Id>
					<Name><![CDATA[order]]></Name>
					<X>170</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trader]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[side]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[price]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[qty]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Order o = new Order();
o.id = main.nextOrderId++;
o.side = side;
o.price = main.roundTick(price);
o.qty = qty;
o.tSubmit = time();
o.expiry = time() + main.orderLife * uniform(0.3, 1.7);
o.trader = trader;
if (halted) pending.add(o);
else { addToBook(o); match(); }]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792677929222</Id>
					<Name><![CDATA[cancelAll]]></Name>
					<X>170</X><Y>330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[Agent]]></Type>
					</Parameter>
					<Body><![CDATA[bids.removeIf(o -> o.trader == a);
asks.removeIf(o -> o.trader == a);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792678487068</Id>
					<Name><![CDATA[check]]></Name>
					<X>170</X><Y>360</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[name]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[ok]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[traceln((ok ? "PASS    " : "FAIL    ") + name);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792678536627</Id>
					<Name><![CDATA[testBook]]></Name>
					<X>170</X><Y>390</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[bids.clear(); asks.clear(); pending.clear();
lastPrice = 0.50; refPrice = 0.50; volume = 0;
boolean collars = main.collarsActive;
main.collarsActive = false;

order(null, 1, 0.50, 100);
order(null, -1, 0.51, 100);
check("1. no crossing: volume 0", volume == 0);
check("1. spread 0.01", Math.abs(spread() - 0.01) < 1e-9);

order(null, -1, 0.50, 40);
check("2. executes 40 at 0.50", volume == 40 && Math.abs(lastPrice - 0.50) < 1e-9);
check("2. 60 left on the bid", bids.peek().qty == 60);

order(null, 1, 0.50, 10);
order(null, -1, 0.50, 65);
check("3. FCFS: volume 105", volume == 105);
check("3. FCFS: second bid keeps 5", bids.size() == 1 && bids.peek().qty == 5);

order(null, -1, 0.52, 100);
order(null, 1, 0.52, 150);
check("4. sweeps two levels: volume 255", volume == 255);
check("4. last price 0.52", Math.abs(lastPrice - 0.52) < 1e-9);
check("4. 50 left at 0.52", Math.abs(asks.peek().price - 0.52) < 1e-9 && asks.peek().qty == 50);

main.collarsActive = true;
order(null, -1, 0.40, 100);
check("5. collar: trade blocked", volume == 255);

cancelAll(null);
check("6. cancelAll empties the book", bids.isEmpty() && asks.isEmpty());

main.collarsActive = collars;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792680505202</Id>
					<Name><![CDATA[startHalt]]></Name>
					<X>170</X><Y>420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[halted = true;
haltStart = time();
prePrice = lastPrice;
main.broadcast("HALT");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792680582001</Id>
					<Name><![CDATA[endHalt]]></Name>
					<X>170</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[main.broadcast("REOPEN");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792680700961</Id>
					<Name><![CDATA[runAuction]]></Name>
					<X>170</X><Y>480</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double bestP = lastPrice;
int bestQ = 0;
java.util.TreeSet<Double> cands = new java.util.TreeSet<>();
for (Order o : bids) cands.add(o.price);
for (Order o : asks) cands.add(o.price);
for (double p : cands) {
    int dem = 0, sup = 0;
    for (Order o : bids) if (o.price >= p) dem += o.qty;
    for (Order o : asks) if (o.price <= p) sup += o.qty;
    int q = Math.min(dem, sup);
    if (q > bestQ || (q == bestQ && q > 0 && Math.abs(p - lastPrice) < Math.abs(bestP - lastPrice))) {
        bestQ = q;
        bestP = p;
    }
}
while (bestQ > 0 && !bids.isEmpty() && !asks.isEmpty()
       && bids.peek().price >= bestP && asks.peek().price <= bestP) {
    Order b = bids.peek();
    Order a = asks.peek();
    execute(b, a, bestP, Math.min(a.qty, b.qty));
}
refPrice = lastPrice;]]></Body>
				</Function>
			</Functions>

